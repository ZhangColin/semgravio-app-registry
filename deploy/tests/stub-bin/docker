#!/usr/bin/env bash
# release 测试替身 docker：模拟服务器侧 docker 行为，调用记入 $STUB_DOCKER_LOG 供断言。
# 场景旋钮（环境变量）：
#   STUB_INFRA_MISSING="semgravio-redis"      → 这些容器 docker inspect 报 missing
#   STUB_INFRA_UNHEALTHY="semgravio-pg ..."   → 这些容器报 unhealthy（其余 healthy）
#   STUB_NO_WEBNET=1                          → docker network inspect webnet 失败
#   STUB_HEALTH_FAIL=1                        → 应用 actuator 探活（docker exec ... curl）恒失败
set -u

log() { echo "$*" >> "${STUB_DOCKER_LOG:?STUB_DOCKER_LOG 未设置}"; }

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  inspect)
    # 形态：docker inspect -f {{.State.Health.Status}} <name>
    name="${!#}"
    case " ${STUB_INFRA_MISSING:-} " in *" $name "*) echo "missing"; exit 0 ;; esac
    case " ${STUB_INFRA_UNHEALTHY:-} " in *" $name "*) echo "unhealthy"; exit 0 ;; esac
    echo "healthy"
    ;;
  network)
    # 形态：docker network inspect webnet
    name="${!#}"
    if [ "${STUB_NO_WEBNET:-0}" = "1" ] && [ "$name" = "webnet" ]; then
      exit 1
    fi
    ;;
  exec)
    # 形态：docker exec semgravio-app-registry curl -sf -o /dev/null http://localhost:8088/actuator/health
    log "exec $*"
    if [ "${STUB_HEALTH_FAIL:-0}" = "1" ]; then
      exit 1
    fi
    exit 0
    ;;
  compose)
    log "compose $*"
    exit 0
    ;;
  *)
    log "$cmd $*"
    ;;
esac
