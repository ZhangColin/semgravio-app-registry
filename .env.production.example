# semgravio-app-registry 生产环境变量模板（issue #27 清理口径）
# 复制为 .env.production 并填值（gitignored：不进 Git/部署包/不经 scp 上传，仅在服务器应用目录，600）。
# 本服务是共享 semgravio-infra 的普通接入方：不复制旧地址/旧服务器密码，不配置本服务不消费的变量。
# 首次自动准备 env（独立数据库接入 + 全量校验）由 deploy/release.sh 首次发布自动完成（#28）；
# 本模板供人工核对/本地排练，服务器正本 .env.production（600）永不被部署包覆盖。

SPRING_PROFILES_ACTIVE=prod

# 数据库：共享 semgravio-pg（webnet 容器 DNS）内的独立库 + 同名低权限角色（greenfield，
# #26 决策 6/7；经 infra ensure-db-user 接入，应用只持有自己的库密码，不接触 PG 超管密码）
SPRING_DATASOURCE_URL=jdbc:postgresql://semgravio-pg:5432/semgravio_app_registry
SPRING_DATASOURCE_USERNAME=semgravio_app_registry
SPRING_DATASOURCE_PASSWORD=<ensure-db-user 生成的应用库密码>

# Redis：共享 semgravio-redis 已启用 requirepass（webnet 容器 DNS），密码与 semgravio-infra
# 凭据正本的 REDIS_PASSWORD 同值。prod 配置显式消费 REDIS_PASSWORD，缺失即启动失败（fail-fast）。
REDIS_HOST=semgravio-redis
REDIS_PORT=6379
REDIS_PASSWORD=<与 semgravio-infra 凭据正本同值>

# apiSecret AES-GCM 主密钥（ADR-0002）：Base64 编码的恰好 32 字节（AES-256）。
# 生成示例：openssl rand -base64 32
# 首次发布后终身不变（#26 决策 10：历史密文始终可解）；丢失且未离线备份 = 全部 apiSecret
# 不可恢复。绝不打印、不进 Git/部署包，维护者须自行备份到密码管理器等离线介质。
APP_REGISTRY_API_SECRET_MASTER_KEY=<openssl rand -base64 32>
